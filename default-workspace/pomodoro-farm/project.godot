; Engine configuration file.
; 番茄钟 + 农场养成学习系统（Godot 4.x 本地客户端）
config_version=5

[application]

config/name="番茄农场 Pomodoro Farm"
config/description="番茄钟 + 农场养成学习系统（课程小组项目）"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Storage="*res://scripts/packages/base_storage.gd"
Pomodoro="*res://scripts/packages/pomodoro.gd"
Farm="*res://scripts/packages/farm.gd"
TaskStats="*res://scripts/packages/task_stats.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=820
window/size/window_width_override=1280
window/size/window_height_override=820
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.949, 0.957, 0.973, 1)
